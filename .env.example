# Server-only secrets and storage configuration
CLIENT_SECRET=
REDIS_URL=

# Required when self-hosting. Vercel deployments use VERCEL_PROJECT_ID by default.
KV_PREFIX=ovi:replace-with-a-unique-deployment-id:

# Prefer the immutable Microsoft account ID when available.
OWNER_USER_ID=

# Used as the owner fallback and displayed client-side by design.
NEXT_PUBLIC_USER_PRINCIPLE_NAME=
