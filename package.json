    "@headlessui/react": "^2.2.10",
    "@vercel/analytics": "^2.0.1",
    "awesome-debounce-promise": "^2.1.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "emoji-regex": "^10.6.0",
    "i18next": "^26.4.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
