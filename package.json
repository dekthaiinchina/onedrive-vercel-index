    "next": "^16.3.3",
    "next-i18next": "^16.0.11",
    "nextjs-progressbar": "^0.0.16",
    "plyr-react": "^6.0.0",
    "react": "^19.2.8",
    "react-async-hook": "^4.0.0",
    "react-audio-player": "^0.17.0",
    "react-cookie": "^8.1.2",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-hotkeys-hook": "^5.3.3",
