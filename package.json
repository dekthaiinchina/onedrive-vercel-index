{
  "name": "onedrive-vercel-index",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" src/styles/globals.css \"config/**/*.js\" \"*.{js,mjs}\" i18next.config.ts package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" src/styles/globals.css \"config/**/*.js\" \"*.{js,mjs}\" i18next.config.ts package.json tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run build",
    "extract": "i18next-cli extract"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
